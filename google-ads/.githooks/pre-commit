#!/usr/bin/env bash
# Enable with:  git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'MSG'
pre-commit: gitleaks is not installed, and this repo does not accept commits without it.

  macOS:  brew install gitleaks
  Linux:  go install github.com/zricethezav/gitleaks/v8@latest
  or:     https://github.com/gitleaks/gitleaks/releases
MSG
  exit 1
fi

echo "pre-commit: scanning staged changes for secrets..."
if ! gitleaks git "$ROOT" --staged -c "$ROOT/.gitleaks.toml" --redact -v --exit-code 1; then
  cat >&2 <<'MSG'

COMMIT REJECTED — a secret-shaped string is staged.

The value is redacted above deliberately; look at the reported file and line.
If it is a genuine false positive, add a narrowly scoped rule to .gitleaks.toml
with a comment saying why.

Do NOT use --no-verify. GitHub push protection will reject the push anyway, and
by then the secret is in your local history.
MSG
  exit 1
fi

"$ROOT/scripts/check-no-inline-defaults.sh" --staged
