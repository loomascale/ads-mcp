# --- Build output ---
target/
!.mvn/wrapper/maven-wrapper.jar
build/
out/

# --- Local configuration and secrets. NEVER remove these lines. ---
# The codebase this was extracted from leaked ~18 live credentials because
# application.yml was tracked AND carried ${ENV:literal} fallback defaults.
# See CONTRIBUTING.md. application.yml itself is deliberately tracked here: it is
# the fail-fast placeholder and names no secret. What is ignored is every LOCAL
# override, which is where a real value will actually end up.
application-local.yml
application-local*.yml
application-secrets.yml
src/main/resources/application-local*.yml
src/test/resources/application-local*.yml
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.key
credentials.json
service-account*.json
gpg-private-key*

# --- IDE ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath

# --- OS ---
.DS_Store
Thumbs.db

# --- Scanner artifacts ---
gitleaks-report.json
*.sarif
