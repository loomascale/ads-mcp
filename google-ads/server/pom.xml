<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.loomascale</groupId>
    <artifactId>google-ads-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>google-ads-mcp</artifactId>
  <packaging>jar</packaging>

  <name>google-ads-mcp</name>
  <description>The runnable MCP server: Google Ads tools, spend guardrails, the connect
    flow, and a Spring Boot application.</description>
  <!-- Overrides the inherited hub URL: this artifact has its own documentation page, and
       this value reaches Maven Central metadata. -->
  <url>https://ai.loomascale.com/oss/google-ads-mcp</url>

  <dependencies>
    <dependency>
      <groupId>com.loomascale</groupId>
      <artifactId>google-ads-client</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Pinned exactly, never a range: a version range makes the build
         non-reproducible and lets an upstream release break it with no commit to blame. -->
    <dependency>
      <groupId>com.loomascale</groupId>
      <artifactId>mcp-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-retry</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Produces the executable jar. The plain jar remains the main artifact, so this
           module is still usable as a dependency. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <configuration>
          <classifier>exec</classifier>
          <mainClass>com.loomascale.googleads.mcp.GoogleAdsMcpApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
