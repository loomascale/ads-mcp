# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; keep it that way.
#
# Every value below is a PLACEHOLDER. If you can copy this file unedited and the server
# starts, that is a bug — please report it.
# ---------------------------------------------------------------------------

# --- Google Ads API -------------------------------------------------------
# Developer token: apply in your Google Ads MANAGER (MCC) account under
# Tools & Settings -> API Center. A new token has Test Account access only, which can
# reach test accounts and nothing else — the single most common reason a first run
# returns empty lists. Request Basic access for production; approval takes days, not
# minutes, so start here before anything else.
GOOGLE_ADS_DEVELOPER_TOKEN=REPLACE_ME_22_CHAR_DEV_TOKEN

# OAuth client: Google Cloud console -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application. Enable the "Google Ads API"
# on the same project first, and add GOOGLE_ADS_REDIRECT_URI below as an authorised
# redirect URI — Google refuses with redirect_uri_mismatch if it differs by even a slash.
GOOGLE_ADS_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=REPLACE_ME

# Must match a redirect URI registered on the OAuth client above, exactly.
GOOGLE_ADS_REDIRECT_URI=http://localhost:8080/connect/google/callback

# --- This server's own OAuth (how ChatGPT or Claude authenticates to it) ---
# The public origin clients reach this server at. They read it from /.well-known and then
# talk to whatever it says, so a stale value fails in a way that looks like a client bug.
# Must be https in production: the bearer token travels in a header.
OAUTH_ISSUER=http://localhost:8080

# Signs the access tokens this server issues. Anyone holding it can mint a token for any
# account, so treat it like a password.
#   openssl rand -base64 48
OAUTH_ACCESS_TOKEN_SECRET=REPLACE_ME_openssl_rand_base64_48

# Encrypts stored Google credentials at rest (AES-256-GCM). Losing it means reconnecting;
# leaking it means every stored token is readable. Base64 of exactly 32 bytes:
#   openssl rand -base64 32
MCP_TOKEN_ENCRYPTION_KEY=REPLACE_ME_openssl_rand_base64_32

# Authorises consent and the connect flow. This is the password that lets a client be
# connected to your ad accounts, and that lets an ad account be connected at all.
#   openssl rand -base64 24
MCP_CONSENT_OPERATOR_PASSWORD=REPLACE_ME_openssl_rand_base64_24

# --- Database -------------------------------------------------------------
# docker-compose.yml wires these to the bundled Postgres. Override for an external one.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/googleadsmcp
SPRING_DATASOURCE_USERNAME=googleadsmcp
SPRING_DATASOURCE_PASSWORD=REPLACE_ME_openssl_rand_base64_24
POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_base64_24

# --- Spend guardrails -----------------------------------------------------
# In minor units of the ad account's own currency (so 10000 = 100.00). These are the last
# line of defence between a model and real money: lower them before pointing this server
# at a live account.
MCP_DEFAULT_MAX_DAILY_BUDGET_CENTS=10000
MCP_DEFAULT_MAX_ACCOUNT_BUDGET_CENTS=100000

# --- Optional -------------------------------------------------------------
# Shown in messages a model relays to the user.
MCP_BRANDING_PRODUCT_NAME=this server
# Google versions its API in the URL path and retires old versions on a schedule.
GOOGLE_ADS_API_VERSION=v21
