# Copy the Qualifier annotation from the instance variables to the constructor
# see https://github.com/rzwitserloot/lombok/issues/745
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
# Copy @Value onto @RequiredArgsConstructor-generated constructor params too, so
# config injection on final fields resolves
# the placeholder instead of Spring looking for a String bean.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
# Do not copy Spring's field-injection annotation to Lombok-generated accessors.
# Spring otherwise treats the zero-argument getters as invalid injection methods.
