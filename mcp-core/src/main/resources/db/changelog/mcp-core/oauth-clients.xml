<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
    logicalFilePath="db/changelog/mcp-core/oauth-clients.xml">

  <changeSet id="mcp-core-001-oauth-clients" author="mcp-core">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="oauth_clients"/></not>
    </preConditions>
    <createTable tableName="oauth_clients">
      <column name="id" type="VARCHAR(36)">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="client_id" type="VARCHAR(64)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="client_name" type="VARCHAR(255)"/>
      <!-- A JSON array. Kept as JSON so this schema matches applications that already
           wrote it that way; a redirect URI that cannot be read is a client that can no
           longer connect. -->
      <column name="redirect_uris" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="token_endpoint_auth_method" type="VARCHAR(20)" defaultValue="none">
        <constraints nullable="false"/>
      </column>
      <column name="scope" type="TEXT"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
</databaseChangeLog>
