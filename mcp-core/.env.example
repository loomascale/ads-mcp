# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; keep it that way.
#
# Every value below is a PLACEHOLDER. If you can copy this file unedited and the server
# starts, that is a bug — please report it.
# ---------------------------------------------------------------------------

# --- Required: MCP access-token signing key --------------------------------
# Signs the access tokens this server issues to MCP clients. Anyone holding it can mint a
# token for any account, so treat it like a password. Must be distinct from every other
# signing key you use, so a token minted for one purpose can never be presented as
# another.
#   openssl rand -base64 48
OAUTH_ACCESS_TOKEN_SECRET=REPLACE_ME_openssl_rand_base64_48

# --- Required: the public origin clients reach this server at --------------
# Clients read this from /.well-known and then talk to it, so a wrong value silently
# breaks discovery. Must be https in production: the bearer token travels in a header.
OAUTH_ISSUER=https://mcp.example.com

# --- Required if you use the built-in credential store ---------------------
# Encrypts stored ad-platform tokens at rest (AES-256-GCM). Losing it means every user
# must reconnect; leaking it means every stored token is readable. Base64 of exactly 32
# bytes:
#   openssl rand -base64 32
MCP_TOKEN_ENCRYPTION_KEY=REPLACE_ME_openssl_rand_base64_32

# --- Required if you use the bundled consent page --------------------------
# Authorizes consent in single-operator mode. This is the password that lets a client be
# connected to your ad accounts, so make it long and unique.
#   openssl rand -base64 24
MCP_CONSENT_OPERATOR_PASSWORD=REPLACE_ME_openssl_rand_base64_24

# --- Database --------------------------------------------------------------
# No default: an unset datasource must fail loudly rather than fall back to something.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mcp
SPRING_DATASOURCE_USERNAME=mcp
SPRING_DATASOURCE_PASSWORD=REPLACE_ME_openssl_rand_base64_24

# --- Optional --------------------------------------------------------------
# Shown in messages a model relays to the user.
MCP_BRANDING_PRODUCT_NAME=this server
# Comma-separated hosts a registered redirect_uri may use. Empty allows any https URI,
# which is what the MCP specification expects of an open registration endpoint.
MCP_OAUTH_REDIRECT_HOSTS=
